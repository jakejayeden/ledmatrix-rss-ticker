{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "RSS News Ticker Configuration",
  "description": "Configure multiple RSS/Atom feeds and display their headlines as a scrolling ticker.",
  "properties": {
    "feeds": {
      "type": "array",
      "title": "Feeds",
      "description": "Add RSS/Atom feeds. Each row can have its own logo and text colour.",
      "x-widget": "array-table",
      "x-columns": ["enabled", "name", "url", "logo", "text_color"],
      "default": [],
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "enabled": {"type": "boolean", "default": true, "title": "Enabled"},
          "name": {"type": "string", "default": "News", "title": "Name"},
          "url": {
            "type": "string",
            "default": "",
            "title": "RSS URL",
            "format": "uri",
            "x-widget": "url-input"
          },
          "logo": {
            "type": "string",
            "default": "",
            "title": "Logo",
            "description": "Upload a PNG/JPEG/BMP/GIF logo for this feed.",
            "x-widget": "file-upload-single",
            "x-upload-config": {
              "allowed_types": ["image/png", "image/jpeg", "image/bmp", "image/gif"],
              "max_size_mb": 5
            }
          },
          "text_color": {
            "type": "array",
            "title": "Text colour",
            "x-widget": "color-picker",
            "items": {"type": "integer", "minimum": 0, "maximum": 255},
            "minItems": 3,
            "maxItems": 3,
            "default": [255, 255, 255]
          }
        },
        "required": ["url"],
        "additionalProperties": false
      }
    },
    "headlines_per_feed": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 20,
      "description": "How many headlines from one feed are shown before rotating to the next feed."
    },
    "feed_rotation_seconds": {
      "type": "number",
      "default": 30,
      "minimum": 2,
      "maximum": 600,
      "description": "Maximum time to stay on one feed batch before rotating."
    },
    "rss_refresh_seconds": {
      "type": "number",
      "default": 300,
      "minimum": 30,
      "maximum": 86400,
      "description": "How often RSS feeds are refreshed.",
      "x-advanced": true
    },
    "max_headlines_per_feed": {
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 200,
      "description": "Maximum headlines cached per feed.",
      "x-advanced": true
    },
    "scroll_speed_px_per_second": {
      "type": "number",
      "default": 30,
      "minimum": 5,
      "maximum": 200,
      "description": "Ticker scroll speed in pixels per second."
    },
    "headline_gap_px": {
      "type": "integer",
      "default": 18,
      "minimum": 4,
      "maximum": 100,
      "description": "Approximate gap between consecutive headlines in pixels."
    },
    "logo_width": {
      "type": "integer",
      "default": 28,
      "minimum": 12,
      "maximum": 64,
      "description": "Width of the fixed logo area on the left."
    },
    "background_color": {
      "type": "array",
      "title": "Background colour",
      "x-widget": "color-picker",
      "items": {"type": "integer", "minimum": 0, "maximum": 255},
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 0, 0],
      "x-advanced": true
    }
  },
  "additionalProperties": false
}
